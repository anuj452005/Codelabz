FROM node:18-slim

WORKDIR /app

# Install Java required for Firebase Emulators (Debian)
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends openjdk-17-jre-headless && \
    rm -rf /var/lib/apt/lists/*

# Install CLI tools including wait-on to prevent race conditions during startup
RUN npm install -g firebase-tools@13.0.0 wait-on

# Pre-download emulators during the build phase to prevent recurring start-up delays
RUN firebase setup:emulators:firestore && \
    firebase setup:emulators:database && \
    firebase setup:emulators:storage && \
    firebase setup:emulators:pubsub && \
    firebase setup:emulators:ui

# Build Cache Optimization: Copy only package files first to cache the layer
COPY package*.json ./
COPY functions/package*.json ./functions/

# Install dependencies before copying remaining source code
RUN npm install --legacy-peer-deps && cd functions && npm install --legacy-peer-deps && cd ..

# Copy the remaining project files
COPY . .

# Expose Vite & Firebase Emulator ports
EXPOSE 5173 4000 5000 5001 8080 9000 8085 9099 9199 4400

RUN chmod +x ./scripts/entrypoint.sh
CMD ["./scripts/entrypoint.sh"]
